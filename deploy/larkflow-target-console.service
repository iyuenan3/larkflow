[Unit]
Description=larkflow Target owner console and audited session governance
Documentation=https://github.com/iyuenan3/larkflow
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=lf_target_dev
Group=lf_target_dev
WorkingDirectory=/
Environment=HOME=/srv/larkflow/target
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/larkflow/target/venv/bin/larkflow-console --env-file /etc/larkflow-target-console.env --host 127.0.0.1 --port 8780
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Feishu OAuth requires outbound HTTPS. The process still binds only to loopback,
# enforced by both ExecStart and the application server.

[Install]
WantedBy=multi-user.target
