[Unit]
Description=larkflow Target Feishu inbound worker
Documentation=https://github.com/iyuenan3/larkflow
After=network-online.target postgresql.service larkflow-target.service larkflow@dev.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=lf_target_dev
Group=lf_target_dev
WorkingDirectory=/
Environment=HOME=/srv/larkflow/target
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/srv/larkflow/target/venv/bin/larkflow-target --env-file /etc/larkflow-target-inbound.env migrate
ExecStart=/srv/larkflow/target/venv/bin/larkflow-target --env-file /etc/larkflow-target-inbound.env inbound
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
KillMode=control-group
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
