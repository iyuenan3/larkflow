# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

# The Gateway runs as lf_target_dev so PostgreSQL peer authentication applies.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev

# Edge execution reuses the central Attempt lease and result size boundary.
LARKFLOW_EDGE_CLAIM_TTL_SECONDS=300
LARKFLOW_EDGE_MAX_RESULT_BYTES=100000
