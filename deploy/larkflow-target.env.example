# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

# Local peer authentication requires the service to run as lf_target_dev.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev
LARKFLOW_TARGET_TENANT=dev

# Omit to derive <hostname>:<pid> on every process start.
# LARKFLOW_TARGET_WORKER_ID=

LARKFLOW_TARGET_CLAIM_TTL_SECONDS=300
LARKFLOW_TARGET_CANDIDATE_LIMIT=100
# Keep interactive multi-stage IM actions responsive in development. Durable
# claims remain authoritative; LISTEN/NOTIFY can replace this polling later.
LARKFLOW_TARGET_IDLE_MIN_SECONDS=0.25
LARKFLOW_TARGET_IDLE_MAX_SECONDS=1

# The Agent adapter is opt-in and only accepts work.agent.kind=llm.generate.
# Its claim TTL must exceed the sum of every configured route timeout plus the
# safety margin. A single 240 second route fits the 300 second claim above.
LARKFLOW_TARGET_ENABLE_AGENT_EXECUTOR=false
LARKFLOW_TARGET_AGENT_CLAIM_SAFETY_SECONDS=30
LARKFLOW_TARGET_AGENT_MAX_PROMPT_CHARS=20000
LARKFLOW_TARGET_AGENT_MAX_RESULT_CHARS=50000

# OpenAI-compatible route used when the Agent adapter is enabled.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=240
# LLM_NO_PROXY=1

# This adapter only supports the deterministic development.echo Tool kind.
# Keep it false outside an explicit development or recovery rehearsal.
LARKFLOW_TARGET_ENABLE_DEVELOPMENT_EXECUTOR=false

# This production-shaped deterministic adapter only reads the current Attempt
# input snapshot and returns pass/fail evidence. It performs no external I/O.
LARKFLOW_TARGET_ENABLE_CONTENT_CHECK_EXECUTOR=false
LARKFLOW_TARGET_CONTENT_CHECK_MAX_CHARS=50000

# Uses the same LLM route to call the hosted Responses API web_search Tool.
# Confirm provider support and billing before opting in.
LARKFLOW_TARGET_ENABLE_WEB_SEARCH_EXECUTOR=false
LARKFLOW_TARGET_WEB_SEARCH_MAX_PROMPT_CHARS=20000
LARKFLOW_TARGET_WEB_SEARCH_MAX_RESULT_CHARS=50000
LARKFLOW_TARGET_VALIDATE_DIRECTORY=false

# Consume only directory-verified /larkflow IM commands from the durable
# command inbox. The runtime process still has no lark-cli profile access.
LARKFLOW_TARGET_ENABLE_IM_COMMANDS=false
