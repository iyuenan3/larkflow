# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

# The credential-side interactive lane only reads and updates narrowly granted
# IM command and role-binding rows. Domain state remains owned by lf_target_dev.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev?user=lf-dev
LARKFLOW_TARGET_TENANT=dev

LARKFLOW_TARGET_LARK_PROFILE=larkflow
LARKFLOW_TARGET_LARK_IDENTITY=bot

# Concurrency is the number of systemd template instances. Each process must
# claim exactly one item per lane so a slow external call cannot reserve a batch.
LARKFLOW_TARGET_INTERACTIVE_CLAIM_TTL_SECONDS=120
LARKFLOW_TARGET_INTERACTIVE_CLAIM_LIMIT=1
LARKFLOW_TARGET_INTERACTIVE_RETRY_BASE_SECONDS=5
LARKFLOW_TARGET_INTERACTIVE_RETRY_MAX_SECONDS=300
LARKFLOW_TARGET_INTERACTIVE_IDLE_MIN_SECONDS=0.25
LARKFLOW_TARGET_INTERACTIVE_IDLE_MAX_SECONDS=1
