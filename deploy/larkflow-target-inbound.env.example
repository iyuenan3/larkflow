# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev
LARKFLOW_TARGET_TENANT=dev

# Omit to derive <hostname>:<pid>:inbound on every process start.
# LARKFLOW_TARGET_INBOUND_WORKER_ID=

LARKFLOW_TARGET_INBOUND_CLAIM_TTL_SECONDS=120
LARKFLOW_TARGET_INBOUND_CLAIM_LIMIT=20
LARKFLOW_TARGET_INBOUND_RETRY_BASE_SECONDS=5
LARKFLOW_TARGET_INBOUND_RETRY_MAX_SECONDS=300
LARKFLOW_TARGET_INBOUND_IDLE_MIN_SECONDS=0.25
LARKFLOW_TARGET_INBOUND_IDLE_MAX_SECONDS=5
