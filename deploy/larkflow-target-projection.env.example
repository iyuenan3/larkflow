# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

# The lf-dev OS identity maps to a narrowly privileged PostgreSQL role.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev?user=lf-dev
LARKFLOW_TARGET_TENANT=dev

# Reuse the profile in /srv/larkflow/dev without copying its encrypted secret.
LARKFLOW_TARGET_LARK_PROFILE=larkflow
LARKFLOW_TARGET_LARK_IDENTITY=bot

LARKFLOW_TARGET_PROJECTION_CLAIM_TTL_SECONDS=120
LARKFLOW_TARGET_PROJECTION_CLAIM_LIMIT=20
LARKFLOW_TARGET_PROJECTION_RETRY_BASE_SECONDS=5
LARKFLOW_TARGET_PROJECTION_RETRY_MAX_SECONDS=300
LARKFLOW_TARGET_PROJECTION_RECONCILE_BATCH_SIZE=100
LARKFLOW_TARGET_PROJECTION_IDLE_MIN_SECONDS=0.25
LARKFLOW_TARGET_PROJECTION_IDLE_MAX_SECONDS=5
