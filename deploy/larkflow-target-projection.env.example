# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

# The lf-dev OS identity maps to a narrowly privileged PostgreSQL role.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev?user=lf-dev
LARKFLOW_TARGET_TENANT=dev

# Reuse the profile in /srv/larkflow/dev without copying its encrypted secret.
LARKFLOW_TARGET_LARK_PROFILE=larkflow
LARKFLOW_TARGET_LARK_IDENTITY=bot
# Native Docx completion reports are created in this Feishu Drive folder.
# Leave empty only for local development where the bot root is acceptable.
LARKFLOW_DELIVERABLE_FOLDER_TOKEN=

# Interactive command verification and replies run in the dedicated
# larkflow-target-interactive@.service processes. This singleton only owns
# Task, result-message and completion-document projection and reconciliation.
LARKFLOW_TARGET_ENABLE_IM_PROJECTION=false
LARKFLOW_TARGET_ENABLE_DOC_PROJECTION=false

LARKFLOW_TARGET_PROJECTION_CLAIM_TTL_SECONDS=120
LARKFLOW_TARGET_PROJECTION_CLAIM_LIMIT=20
LARKFLOW_TARGET_PROJECTION_RETRY_BASE_SECONDS=5
LARKFLOW_TARGET_PROJECTION_RETRY_MAX_SECONDS=300
LARKFLOW_TARGET_PROJECTION_MAX_ATTEMPTS=24
LARKFLOW_TARGET_PROJECTION_RECONCILE_BATCH_SIZE=100
# Polling is the reliable completion intake path. Event delivery is only a
# latency optimization and must not be required for Human nodes to advance.
LARKFLOW_TARGET_COMPLETION_POLL_SECONDS=30
LARKFLOW_TARGET_COMPLETION_POLL_BATCH_SIZE=100
# Keep the singleton projection loop responsive to durable wakeups and polling.
LARKFLOW_TARGET_PROJECTION_IDLE_MIN_SECONDS=0.25
LARKFLOW_TARGET_PROJECTION_IDLE_MAX_SECONDS=1
