# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.

# Local peer authentication requires the service to run as lf_target_dev.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev
LARKFLOW_TARGET_TENANT=dev

# Keep static for the loopback development fallback. Use feishu only behind a
# stable HTTPS origin configured as the app redirect URL.
LARKFLOW_CONSOLE_AUTH_MODE=static

# Static mode only. Use the exact owner person ID from the Target database.
# Never commit a real ID or token.
LARKFLOW_CONSOLE_PERSON_ID=

# Generate an unpredictable value containing at least 32 characters. The
# browser keeps it in the current tab only. Replace this development boundary
# with Feishu mode before any employee-facing deployment.
LARKFLOW_CONSOLE_ACCESS_TOKEN=

# Feishu mode only. The OAuth flow requests no user scopes, uses OAuth v3 with
# PKCE, reads open_id + tenant_key once, then discards the user access token.
# Store the app secret only in the permission-restricted server env file.
LARKFLOW_CONSOLE_FEISHU_APP_ID=
LARKFLOW_CONSOLE_FEISHU_APP_SECRET=
LARKFLOW_CONSOLE_FEISHU_TENANT_KEY=
LARKFLOW_CONSOLE_PUBLIC_BASE_URL=

# Opaque HttpOnly session lifetime. Only the SHA-256 credential digest and
# server-side principal are stored in PostgreSQL. Range: 300..86400.
LARKFLOW_CONSOLE_SESSION_TTL_SECONDS=28800
