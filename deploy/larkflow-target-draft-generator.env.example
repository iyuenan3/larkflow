# Parsed by larkflow.config.load_dotenv. Never source this file in a shell.
LARKFLOW_TARGET_DSN=postgresql:///larkflow_target_dev
LARKFLOW_TARGET_TENANT=dev

# One worker serializes model-heavy generation. PostgreSQL leases remain the
# source of truth and a second replica can safely take over expired work.
LARKFLOW_TARGET_DRAFT_CLAIM_LIMIT=1
LARKFLOW_TARGET_DRAFT_CLAIM_TTL_SECONDS=600
LARKFLOW_TARGET_DRAFT_CLAIM_SAFETY_SECONDS=30
LARKFLOW_TARGET_DRAFT_RETRY_BASE_SECONDS=5
LARKFLOW_TARGET_DRAFT_RETRY_MAX_SECONDS=300
LARKFLOW_TARGET_DRAFT_MAX_ATTEMPTS=5
LARKFLOW_TARGET_DRAFT_MAX_RESULT_CHARS=30000
LARKFLOW_TARGET_DRAFT_IDLE_MIN_SECONDS=0.25
LARKFLOW_TARGET_DRAFT_IDLE_MAX_SECONDS=1

# The claim TTL must exceed two complete routed calls plus the safety margin.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=240
# LLM_NO_PROXY=1
