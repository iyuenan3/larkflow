# Replace PUBLIC_IP with the server's public IPv4 address.
# Certbot owns certificate issuance. Caddy only serves the ACME webroot,
# redirects HTTP, terminates TLS, and proxies to the loopback Console.
# Do not enable access logs: the OAuth callback query contains a one-time code.
{
	admin 127.0.0.1:2019
	auto_https off
	default_sni PUBLIC_IP
	servers {
		timeouts {
			read_body 15s
			read_header 10s
			write 30s
			idle 2m
		}
		max_header_size 32KB
		0rtt off
	}
}

http://PUBLIC_IP {
	@acme_challenge path /.well-known/acme-challenge/*
	handle @acme_challenge {
		root * /var/lib/larkflow-certbot-webroot
		file_server
	}

	handle {
		redir https://PUBLIC_IP{uri} 308
	}
}

https://PUBLIC_IP {
	tls /etc/caddy/certs/larkflow-console/current/fullchain.pem /etc/caddy/certs/larkflow-console/current/privkey.pem

	@attachment_upload {
		method POST
		path_regexp ^/console/api/v1/drafts/[0-9a-f]{32}/attachments$
	}
	handle @attachment_upload {
		request_body {
			max_size 262144
		}
		reverse_proxy 127.0.0.1:8780 {
			# Overwrite any client-supplied value. The loopback Console trusts this
			# header only for rate-limit fairness, never for identity or authorization.
			header_up X-Larkflow-Client-IP {http.request.remote.host}
		}
	}

	handle {
		request_body {
			max_size 65536
		}
		reverse_proxy 127.0.0.1:8780 {
			# Keep the same trusted-source overwrite on every proxied route.
			header_up X-Larkflow-Client-IP {http.request.remote.host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Permitted-Cross-Domain-Policies "none"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}
}
