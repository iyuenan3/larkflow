# larkflow 环境变量（只列 key 名，绝不写值；真值走 .env / keychain，不入库）
# 飞书 dev 自建应用（ADR-008 独立租户）
LARK_APP_ID=
LARK_APP_SECRET=
# lark-cli 用哪个 profile（auth 走 lark-cli 自身，凭证不落这里）
LARK_PROFILE=

# LLM 网关：火山方舟（Volcengine Ark，OpenAI 兼容 API）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 推理接入点 ID（ep-...）或模型名
ARK_MODEL=

# 引擎持久化（SQLite checkpointer + 关联表；文件不入库）
LARKFLOW_DB=larkflow.sqlite
