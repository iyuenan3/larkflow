# larkflow 环境变量（只列 key 名，绝不写值；真值走 .env / keychain，不入库）
# 飞书 dev 自建应用（ADR-008 独立租户）
LARK_APP_ID=
LARK_APP_SECRET=
# lark-cli 用哪个 profile（auth 走 lark-cli 自身，凭证不落这里）
LARK_PROFILE=

# LLM：OpenAI 兼容接口，按任务角色路由到不同模型 / 供应商。
# 每个角色 = 一组 (base_url, api_key, model)，可分别指向火山方舟 / 中转站 / 直连供应商。
# 要加角色就照此三元组复制一份（如 LLM_IMAGE_*）。
# 默认角色（文本 / 代码等通用推理）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 示例：图片生成角色（按需启用，可用不同 key / 供应商）
# LLM_IMAGE_BASE_URL=
# LLM_IMAGE_API_KEY=
# LLM_IMAGE_MODEL=

# 引擎持久化（SQLite checkpointer + 关联表；文件不入库）
LARKFLOW_DB=larkflow.sqlite
