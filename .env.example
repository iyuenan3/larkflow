# larkflow 环境变量。**只列 key 名，绝不写值**；真值放 .env（已进 .gitignore）或 keychain。
# 这份清单与代码一一对应：每个 key 都真的被读，读它的地方写在小节标题里。
# 飞书凭证（app_id / app_secret / token）**不在这里**：由 lark-cli 自己保管，引擎只透传 profile。

# ── 飞书接入（io/lark_io.py · io/deliverable.py · io/events.py）────────────────
# lark-cli 的 profile 名。凭证由 `lark-cli --profile <名> auth login` 存进 lark-cli，
# 引擎全程只传 --profile，永远不碰 app_secret / token。多个 app 并存就靠它区分。
LARK_PROFILE=
# 以什么身份调飞书：bot | user。**卡片回调只有 bot 收得到**，常驻服务用 bot。
LARKFLOW_IDENTITY=

# ── LLM 多角色路由 + 备用线路（config.load_llm_roles，ADR-017 / ADR-036）──────
# 规则：LLM_<ROLE>_{BASE_URL,API_KEY,MODEL} → 角色 <role>（小写）；无 ROLE 段 = default。
# 节点的 model_role 命中哪个用哪组，未命中回退 default。只填 default 也能跑通所有随包模板。
# **三元组缺项的角色会被整个跳过**（宁可少一个角色，不带半截配置上路），别只填一半。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 备用线路：主线路打不通就顺着往下试。**缺项自动继承主配置**，于是两种用法：
#   ① 只填 BACKUP_API_KEY  = 同供应商同模型换一把 key（被限流时最常见）
#   ② 三项都填             = 换一家供应商 / 换一个模型
# 想再多一条就写 BACKUP2_* / BACKUP3_*，按序号排队。
# 可切的错误：连不上 / 超时 / 429 / 5xx / 401 / 404。**400 与 422 不切**（是我们自己的
# 请求有问题，换条线路只会原样再错一次，还多烧一次钱）。切换会写 daemon 日志，不静默。
LLM_BACKUP_API_KEY=
# 单次生成超时（秒）。默认 300：实测方舟 doubao-seed 起草一份合同商务条款要 110s，
# 原来的 60s 会把起草节点掐断，而那时飞书文档已建、任务已派。
# 起草慢、机检快，所以按角色可配：LLM_<ROLE>_TIMEOUT，备用线路继承主配置。
# LLM_TIMEOUT=
# LLM_BACKUP_BASE_URL=      # 换供应商时才需要；省略 = 沿用上面的 LLM_BASE_URL
# LLM_BACKUP_MODEL=         # 省略 = 沿用上面的 LLM_MODEL
# LLM_BACKUP2_API_KEY=      # 第三条线路（可选）

# 随包模板用到的角色：contract = writer / legal / editor，defect = triage，hiring 不用 LLM。
# 每个角色都可以有自己的备用线路，写法同上（LLM_WRITER_BACKUP_API_KEY=…）。
# LLM_WRITER_BASE_URL=      # contract: 商务条款起草
# LLM_WRITER_API_KEY=
# LLM_WRITER_MODEL=
# LLM_WRITER_BACKUP_API_KEY=
# LLM_LEGAL_BASE_URL=       # contract: 法律条款起草
# LLM_LEGAL_API_KEY=
# LLM_LEGAL_MODEL=
# LLM_LEGAL_BACKUP_API_KEY=
# LLM_EDITOR_BASE_URL=      # contract: 合并成稿
# LLM_EDITOR_API_KEY=
# LLM_EDITOR_MODEL=
# LLM_EDITOR_BACKUP_API_KEY=
# LLM_TRIAGE_BASE_URL=      # defect: 定级分诊
# LLM_TRIAGE_API_KEY=
# LLM_TRIAGE_MODEL=

# ── 角色 → 飞书 open_id（config.RoleResolver.from_env）───────────────────────
# **真栈是 strict 的**：模板里出现、这里没配的角色在装配期直接抛，绝不伪造 ou_<角色名>
# 发到飞书（那样报错会变成飞书的「无效 open_id」，根本看不出是角色没配）。
# 中文角色名当 shell 环境变量名 export 不进去，故以 JSON 为主。各模板需要的角色：
#   contract → 法务 / 财务 / 负责人      defect → QA / 开发 / 负责人
#   hiring   → HRBP / 面试官 / 用人经理
# 形如 LARKFLOW_ROLES={"法务":"ou_...","财务":"ou_...","负责人":"ou_..."}
LARKFLOW_ROLES=
# ASCII 别名写法（辅，与上面合并；键名 = LARKFLOW_ROLE_ 之后的原文）
# LARKFLOW_ROLE_QA=

# ── 交付物落点（io/deliverable.py）──────────────────────────────────────────
# 交付物建在哪个云空间文件夹；留空 = 云空间根目录。可填 folder token 或 Drive folder URL。
LARKFLOW_DRIVE_FOLDER=

# ── 引擎持久化（store.resolve_db_path）──────────────────────────────────────
# SQLite（checkpointer + 关联表 + 幂等表）。留空 = ~/.larkflow/larkflow.sqlite。
# 相对路径会按 cwd 落成绝对路径，但**别用相对路径**：systemd 起的 daemon
# （WorkingDirectory=/）与你手敲的救场命令会静默落到两个库，两边都不报错。
# 必须放**本地盘**：多进程共用它，而 WAL 与 flock 在 NFS / SMB 上都不可靠。
# 锁文件自动落在同目录：<DB>.locks/ 与 <DB>.serve.lock。
LARKFLOW_DB=

# ── 默认模板（__main__.py）──────────────────────────────────────────────────
# serve / start 不带 --template 时用它。留空 = contract。
LARKFLOW_TEMPLATE=

# legacy 定期对账周期（秒），默认 120，配 0 关掉。
# 这是旧 SQLite 状态与飞书投影的恢复兜底。Target Task 完成状态由 Projection 自己轮询，
# 并写入 PostgreSQL Inbox，不依赖这条 legacy 轮询。
LARKFLOW_SWEEP_SECONDS=

# 可选 Target 事件桥。事件只用于降低延迟，legacy 只把 Task 完成事件按 event_id 幂等写入
# PostgreSQL Inbox，不直接改 Target 领域状态。Target 的可靠路径是 Task 状态轮询。
LARKFLOW_TARGET_INBOX_DSN=
LARKFLOW_TARGET_TENANT=

# ── Personal Agent Edge Proof v0（workflow/edge_*）──────────────────────────
# Edge Gateway 与 Target 共用 PostgreSQL 真相源，DSN 继续使用 LARKFLOW_TARGET_DSN。
# Gateway 只监听 loopback，远程设备必须经过独立的 HTTPS 反向代理；Edge 不使用 lark-cli。
LARKFLOW_TARGET_DSN=
# 自动执行租约秒数。必须覆盖本机 Agent 的最长单次运行时间，默认 300。
LARKFLOW_EDGE_CLAIM_TTL_SECONDS=
# 中央接受的单个 Edge 结果上限，按 UTF-8 JSON 字节计，默认 100000。
LARKFLOW_EDGE_MAX_RESULT_BYTES=

# ── 中央只读控制台（workflow/console_*）────────────────────────────────────
# v0 强制只监听 loopback，按服务端配置的 tenant + person 只返回该 Owner 的实例。
# access token 至少 32 个字符，只放权限收紧的 env 文件，不放命令行、URL 或仓库。
LARKFLOW_CONSOLE_PERSON_ID=
LARKFLOW_CONSOLE_ACCESS_TOKEN=

# ── 不是引擎读的，但影响引擎 spawn 出来的 lark-cli ──────────────────────────
# 本机 shell 有 Clash 全局代理，lark-cli 会警告「凭证将经由该代理传输」。飞书是境内服务、
# 直连即可，故建议置 1 让 lark-cli 绕开代理（顺带消掉那条警告）。
# 若置 1 后反而连不上（少见），改用 LARK_CLI_NO_PROXY_WARN=1 保留代理并静音警告。
LARK_CLI_NO_PROXY=
# 同理，引擎自己的 LLM 出站是否吃环境代理。置 1 = 不吃（trust_env=False）。
# 本机 Clash 会把 all_proxy 设成 socks5://…，而 httpx 在**建客户端那一刻**就急切
# 构造 socks 传输，缺 socksio 直接 ImportError；实测 no_proxy 救不了，只有这个开关能。
# LLM 在墙外、确实要走代理时留空（默认吃环境代理）。
LLM_NO_PROXY=
