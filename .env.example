# larkflow 环境变量。**只列 key 名，绝不写值**；真值放 .env（已进 .gitignore）或 keychain。
# 这份清单与代码一一对应：每个 key 都真的被读，读它的地方写在小节标题里。
# 飞书凭证（app_id / app_secret / token）**不在这里**：由 lark-cli 自己保管，引擎只透传 profile。

# ── 飞书接入（io/lark_io.py · io/deliverable.py · io/events.py）────────────────
# lark-cli 的 profile 名。凭证由 `lark-cli --profile <名> auth login` 存进 lark-cli，
# 引擎全程只传 --profile，永远不碰 app_secret / token。多个 app 并存就靠它区分。
LARK_PROFILE=
# 以什么身份调飞书：bot | user。**卡片回调只有 bot 收得到**，常驻服务用 bot。
LARKFLOW_IDENTITY=

# ── LLM 多角色路由（config.load_llm_roles，ADR-017）──────────────────────────
# 规则：LLM_<ROLE>_{BASE_URL,API_KEY,MODEL} → 角色 <role>（小写）；无 ROLE 段 = default。
# 节点的 model_role 命中哪个用哪组，未命中回退 default。只填 default 也能跑通所有随包模板。
# **三元组缺项的角色会被整个跳过**（宁可少一个角色，不带半截配置上路），别只填一半。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 随包模板用到的角色：contract = writer / legal / editor，defect = triage，hiring 不用 LLM。
# LLM_WRITER_BASE_URL=      # contract: 商务条款起草
# LLM_WRITER_API_KEY=
# LLM_WRITER_MODEL=
# LLM_LEGAL_BASE_URL=       # contract: 法律条款起草
# LLM_LEGAL_API_KEY=
# LLM_LEGAL_MODEL=
# LLM_EDITOR_BASE_URL=      # contract: 合并成稿
# LLM_EDITOR_API_KEY=
# LLM_EDITOR_MODEL=
# LLM_TRIAGE_BASE_URL=      # defect: 定级分诊
# LLM_TRIAGE_API_KEY=
# LLM_TRIAGE_MODEL=

# ── 角色 → 飞书 open_id（config.RoleResolver.from_env）───────────────────────
# **真栈是 strict 的**：模板里出现、这里没配的角色在装配期直接抛，绝不伪造 ou_<角色名>
# 发到飞书（那样报错会变成飞书的「无效 open_id」，根本看不出是角色没配）。
# 中文角色名当 shell 环境变量名 export 不进去，故以 JSON 为主。各模板需要的角色：
#   contract → 法务 / 财务 / 负责人      defect → QA / 开发 / 负责人
#   hiring   → HRBP / 面试官 / 用人经理
# 形如 LARKFLOW_ROLES={"法务":"ou_...","财务":"ou_...","负责人":"ou_..."}
LARKFLOW_ROLES=
# ASCII 别名写法（辅，与上面合并；键名 = LARKFLOW_ROLE_ 之后的原文）
# LARKFLOW_ROLE_QA=

# ── 交付物落点（io/deliverable.py）──────────────────────────────────────────
# 交付物建在哪个云空间文件夹；留空 = 云空间根目录。可填 folder token 或 Drive folder URL。
LARKFLOW_DRIVE_FOLDER=

# ── 引擎持久化（store.resolve_db_path）──────────────────────────────────────
# SQLite（checkpointer + 关联表 + 幂等表）。留空 = ~/.larkflow/larkflow.sqlite。
# 相对路径会按 cwd 落成绝对路径，但**别用相对路径**：systemd 起的 daemon
# （WorkingDirectory=/）与你手敲的救场命令会静默落到两个库，两边都不报错。
# 必须放**本地盘**：多进程共用它，而 WAL 与 flock 在 NFS / SMB 上都不可靠。
# 锁文件自动落在同目录：<DB>.locks/ 与 <DB>.serve.lock。
LARKFLOW_DB=

# ── 默认模板（__main__.py）──────────────────────────────────────────────────
# serve / start 不带 --template 时用它。留空 = contract。
LARKFLOW_TEMPLATE=

# ── 不是引擎读的，但影响引擎 spawn 出来的 lark-cli ──────────────────────────
# 本机 shell 有 Clash 全局代理，lark-cli 会警告「凭证将经由该代理传输」。飞书是境内服务、
# 直连即可，故建议置 1 让 lark-cli 绕开代理（顺带消掉那条警告）。
# 若置 1 后反而连不上（少见），改用 LARK_CLI_NO_PROXY_WARN=1 保留代理并静音警告。
LARK_CLI_NO_PROXY=
