# larkflow 真栈配置。真值只放 .env，.env 已进入 .gitignore。
# .env 与 .env.example 的 key、顺序和注释保持一致，example 只保留空值。

# ── 豆包搜索 Custom API（待接入 SearchProvider）──────────────────────
# Bot ID 与 API ID 仅作控制台资源标识；Custom 直连搜索请求只使用 API Key。
LARKFLOW_DOUBAO_SEARCH_BOT_ID=
LARKFLOW_DOUBAO_SEARCH_API_ID=
LARKFLOW_DOUBAO_SEARCH_API_KEY=

# ── 飞书接入 ────────────────────────────────────────────────────────────────
LARK_PROFILE=
LARKFLOW_IDENTITY=
# 飞书是境内服务，凭证没必要绕 Clash；顺带消掉 lark-cli 那条代理警告
LARK_CLI_NO_PROXY=
# 同理，LLM 出站也别绕 Clash：本机 all_proxy 是 socks5，httpx 缺 socksio
# 会在建客户端那一刻就 ImportError（实测 no_proxy 救不了）。方舟是境内服务。
LLM_NO_PROXY=

# ── 角色 → open_id ─────────────────────────────────────────────────────────
# 注意：open_id 是**按 app 隔离**的，下面这个是 larkflow app（cli_aaee5b03…）下的值，
# 与机器上另一个 profile 给出的 open_id 不是同一个，别混用。
# 第一条 e2e 你扮全部角色，所以三个都是你自己。之后拉真人进来时按人替换。
LARKFLOW_ROLES=

# ── LLM（需要你填）─────────────────────────────────────────────────────────
# 只填这一组 default 就能跑通 contract 图（writer / legal / editor 未命中会回退到它）。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 备用线路：只填 key = 同供应商换把 key；三项都填 = 换一家。留空则没有备用。
LLM_WEB_SEARCH_CAPABILITY=
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=
# 单次生成超时（秒），默认 300。实测起草一份合同商务条款要 110s。
LLM_TIMEOUT=
LLM_BACKUP_MODEL=

LLM_BACKUP2_API_KEY=
LLM_BACKUP2_BASE_URL=
LLM_BACKUP2_MODEL=


# ── 其余走默认 ─────────────────────────────────────────────────────────────
# Target 与 Console 当前默认值；未配置的连接与身份保持留空。
LARKFLOW_SWEEP_SECONDS=
LARKFLOW_TARGET_INBOX_DSN=
LARKFLOW_TARGET_TENANT=
LARKFLOW_TARGET_DSN=
LARKFLOW_EDGE_CLAIM_TTL_SECONDS=
LARKFLOW_EDGE_MAX_RESULT_BYTES=
LARKFLOW_CONSOLE_AUTH_MODE=
LARKFLOW_CONSOLE_PERSON_ID=
LARKFLOW_CONSOLE_ACCESS_TOKEN=
LARKFLOW_CONSOLE_FEISHU_APP_ID=
LARKFLOW_CONSOLE_FEISHU_APP_SECRET=
LARKFLOW_CONSOLE_FEISHU_TENANT_KEY=
LARKFLOW_CONSOLE_PUBLIC_BASE_URL=
LARKFLOW_CONSOLE_SESSION_TTL_SECONDS=
LARKFLOW_CONSOLE_ADMIN_PERSON_IDS=
LARKFLOW_TARGET_AGENT_RUNTIME=
LARKFLOW_TARGET_PLANNER_RUNTIME=
LARKFLOW_TARGET_ATTACHMENT_ROOT=
LARKFLOW_TARGET_ATTACHMENT_MODEL_EGRESS=
LARKFLOW_TARGET_ENABLE_WEB_SEARCH_EXECUTOR=
LARKFLOW_TARGET_DRAFT_ENABLE_WEB_SEARCH=

# 飞书云文档交付物的父文件夹 token；留空时落在 bot 的个人空间根目录
LARKFLOW_DELIVERABLE_FOLDER_TOKEN=
# 库落 ~/.larkflow/larkflow.sqlite（绝对路径，daemon 与 CLI 不会各看各的）
LARKFLOW_DB=
LARKFLOW_TEMPLATE=
