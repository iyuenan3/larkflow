# larkflow 环境变量（只列 key 名，绝不写值；真值走 .env / keychain，不入库）
# 飞书 dev 自建应用（ADR-008 独立租户）
LARK_APP_ID=
LARK_APP_SECRET=
# lark-cli 用哪个 profile（auth 走 lark-cli 自身，凭证不落这里）
LARK_PROFILE=
# lark-cli 身份：bot | user（卡片回调只有 bot 收得到，默认 bot）
LARKFLOW_IDENTITY=
# 默认模板名（larkflow serve / start 不带 --template 时用它）
LARKFLOW_TEMPLATE=

# LLM：OpenAI 兼容接口，按任务角色路由到不同模型 / 供应商（ADR-017）。
# 每个角色 = 一组 (base_url, api_key, model)，可分别指向火山方舟 / 中转站 / 直连供应商。
# 装配规则（config.load_llm_roles）：LLM_<ROLE>_* → 角色 <role>（小写）；无 ROLE 段 = default。
# 三元组缺项的角色会被跳过（宁可少一个角色，不带半截配置上路）；节点 model_role 未命中回退 default。
# 默认角色（兜底）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 合同图用到的角色（templates/contract.yaml 的 model_role）
# LLM_WRITER_BASE_URL=      # 商务条款起草
# LLM_WRITER_API_KEY=
# LLM_WRITER_MODEL=
# LLM_LEGAL_BASE_URL=       # 法律条款起草
# LLM_LEGAL_API_KEY=
# LLM_LEGAL_MODEL=
# LLM_EDITOR_BASE_URL=      # 合并成稿
# LLM_EDITOR_API_KEY=
# LLM_EDITOR_MODEL=
# 缺陷图用到的角色（templates/defect.yaml）
# LLM_TRIAGE_BASE_URL=
# LLM_TRIAGE_API_KEY=
# LLM_TRIAGE_MODEL=

# 交付物落到哪个云空间文件夹（省略 = 根目录）；可填 folder token 或 Drive folder URL
LARKFLOW_DRIVE_FOLDER=

# assignee_role → 飞书 open_id。**真栈 strict**：未配置的角色直接抛，绝不伪造 ou_<角色>
# 发到飞书（那样报错会变成 lark-cli 的「无效 open_id」，根本看不出是角色没配）。
# 中文角色名当环境变量名在 shell 里 export 不进去，故以 JSON 为主：
LARKFLOW_ROLES={"财务":"ou_xxx","法务":"ou_xxx","负责人":"ou_xxx","HRBP":"ou_xxx","面试官":"ou_xxx","用人经理":"ou_xxx"}
# ASCII 别名写法（辅，会与上面合并）
# LARKFLOW_ROLE_FINANCE=ou_xxx

# 引擎持久化（SQLite checkpointer + 关联表 + 幂等表；文件不入库）
# 必须放**本地盘**：多进程共用它（daemon + 一次性 CLI 命令），而 WAL 与 flock 在
# NFS / SMB 上都不可靠。锁文件自动落在同目录：<DB>.locks/ 与 <DB>.serve.lock。
LARKFLOW_DB=larkflow.sqlite
