# larkflow 环境变量（只列 key 名，绝不写值；真值走 .env / keychain，不入库）
# 飞书 dev 自建应用（ADR-008 独立租户）
LARK_APP_ID=
LARK_APP_SECRET=
# lark-cli 用哪个 profile（auth 走 lark-cli 自身，凭证不落这里）
LARK_PROFILE=

# newapi 网关（LLM 只走 newapi，ADR / 红线）
NEWAPI_BASE_URL=https://<your-newapi-host>:8888/v1
NEWAPI_API_KEY=
# Caddy 自签根证书的绝对路径（信任自签 TLS，绝不 verify=False）
NEWAPI_CA_BUNDLE=

# 引擎持久化（SQLite checkpointer + 关联表；文件不入库）
LARKFLOW_DB=larkflow.sqlite
